# App
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (Neon PostgreSQL)  you can give DATABASE_URL and  DATABASE_URL_POOLED same if one is missing
DATABASE_URL=
DATABASE_URL_POOLED=

# Email (Resend — optional, logs to console if omitted)
RESEND_API_KEY=
EMAIL_FROM=

# Storage (Cloudinary — optional, falls back to local public/uploads if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
